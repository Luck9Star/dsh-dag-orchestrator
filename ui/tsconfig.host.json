{
  // Host-half program (node process side): src/index.ts + src/host/ + the
  // shared pure logic in src/core/. SDK types resolve from the
  // @deepseek-ai/cordis npm package in devDependencies, never from a
  // source checkout.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/core/**/*.ts",
    "src/host/**/*.ts"
  ]
}
